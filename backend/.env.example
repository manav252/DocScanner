# Copy to .env for local development (docker compose reads it). Never commit .env.
DOCSCANNER_ENVIRONMENT=development
DOCSCANNER_JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=docscanner
MINIO_ROOT_USER=docscanner
MINIO_ROOT_PASSWORD=docscanner-secret
API_PORT=8000

# --- Hosted (Render): set these in the Render dashboard, not in a file ---
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require   (Neon, direct connection)
# DOCSCANNER_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com                 (Cloudflare R2)
# DOCSCANNER_S3_ACCESS_KEY=<R2 access key id>
# DOCSCANNER_S3_SECRET_KEY=<R2 secret access key>
# DOCSCANNER_S3_BUCKET=docscanner
# DOCSCANNER_S3_REGION=auto
# DOCSCANNER_S3_CREATE_BUCKET=false
# DOCSCANNER_JWT_SECRET=<long random string; Render can generate it>
# DOCSCANNER_CORS_ORIGINS=["https://manav252.github.io"]
